{
  "name": "billing-desktop",
  "version": "1.0.0",
  "description": "Billing Software - Local Desktop Edition",
  "main": "main.js",
  "author": "Billing Software",
  "scripts": {
    "backend": "npm start --prefix backend",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:start": "npm run start --prefix frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend:dev\"",
    "start": "concurrently \"npm run backend\" \"npm run frontend:start\"",
    "electron:dev": "concurrently \"npm run backend\" \"npm run frontend:dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "build:exe": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.billing.desktop",
    "productName": "Billing",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist_exe"
    },
    "files": [
      "main.js",
      "backend/src/**/*",
      "backend/package.json",
      "frontend/.next/**/*",
      "frontend/public/**/*",
      "frontend/package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "frontend/public/favicon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Billing Software"
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.5"
  }
}
